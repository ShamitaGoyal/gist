# Answer generation. Embeddings always use the local Ollama model nomic-embed-text.
# Ollama is the default. Gemini is not contacted unless LLM_PROVIDER=gemini.
LLM_PROVIDER=ollama

# Used only when LLM_PROVIDER=ollama.
OLLAMA_MODEL=llama3.2:1b

# Used only when LLM_PROVIDER=gemini. Do not commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local safeguards for this application. They are not Google account quotas.
# The daily count is stored locally and resets at the next UTC date.
# The per-minute count is an in-memory rolling 60-second window and resets
# when the process restarts.
GEMINI_MAX_REQUESTS_PER_MINUTE=5
GEMINI_MAX_REQUESTS_PER_DAY=50
GEMINI_MAX_INPUT_TOKENS=12000
GEMINI_MAX_OUTPUT_TOKENS=1000
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_DELAY_SECONDS=2
GEMINI_USAGE_PATH=data/gemini_usage.json

# API. A wildcard origin is ignored because credentials are enabled.
CORS_ORIGINS=http://localhost:3000
GIST_UPLOAD_DIR=data/uploads
GIST_MAX_UPLOAD_BYTES=20971520
